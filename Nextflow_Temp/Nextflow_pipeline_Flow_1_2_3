  # Run CLARC
  clarc --input_dir ${params.path_nextflow_dir}/14.Pangenome_analysis/14.4.ROARY_CLARC/data --output_dir ${params.path_nextflow_dir}/14.Pangenome_analysis/14.4.ROARY_CLARC/Output
