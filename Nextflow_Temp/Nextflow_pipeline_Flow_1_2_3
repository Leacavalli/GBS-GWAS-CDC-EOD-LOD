process UNITIG {
  conda "unitig-counter"

  input:
  val base


  output:
  val base

  script:
  """
  # Prepare input file
  for i in ${params.path_nextflow_dir}/5.ASSEMBLIES/*fasta
  do
  sample=\$(echo \$i | cut -d '/' -f9-9 | cut -d '.' -f1-1)
  echo -e "\$sample\t\$i"
  done > qfile.txt

  # Run Unitig
  unitig-counter -strains qfile.txt -output ${params.path_nextflow_dir}/15.UNITIGS -nb-cores 8
  cdbg-ops extend --graph ${params.path_nextflow_dir}/15.UNITIGS/graph --unitigs ${params.path_nextflow_dir}/15.UNITIGS/unitigs.txt > ${params.path_nextflow_dir}/15.UNITIGS/extended.txt
  """
}



workflow flow1 {
take: data
main:
    Make_architecture(data)
    Serotype_MLST(Make_architecture.out[0])
    Trimmomatic(Make_architecture.out[0])
    FastQC(Trimmomatic.out)
    SNIPPY(Trimmomatic.out)
    ASSEMBLY(Trimmomatic.out)
    ANNOTATION(ASSEMBLY.out)
    FastANI(ASSEMBLY.out)
    QUAST(ASSEMBLY.out)
emit: QUAST.out[0]
}

workflow flow2 {
take: data
main:
    Filter_out_QC(data)
emit: Filter_out_QC.out
}

workflow flow3 {
    take: data
    main:
    POPPUNK(data)
    ASSIGN_CC(data)
    SNIPPY_MULTI(data)
    FASTTREE(SNIPPY_MULTI.out[0])
    RAxML(SNIPPY_MULTI.out[0])
    PANAROO(data)
    PANAROO_CLARC(PANAROO.out[0])
    ROARY(data)
    ROARY_CLARC(ROARY.out[0])
    UNITIG(data)
    emit: UNITIG.out
}

workflow {
  channel.fromFilePairs("${params.path_nextflow_dir}/0.RAW_READS/SRR*_{1,2}.fastq.gz")
         .map { it[0] }
         | flow1
         | flow2
         | collect
         | flow3
}
