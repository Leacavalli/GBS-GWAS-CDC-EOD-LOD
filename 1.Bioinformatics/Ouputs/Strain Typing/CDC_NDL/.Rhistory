legend.title = element_text(size = 15),   # legend title
legend.text  = element_text(size = 13)    # legend labels
)
# Serotypes vs AGe Cat in each country
# chi-square tests of Serotype2 vs Age_cat, stratified by country
metadata_tree_CDC <- metadata_tree_v0 |> filter(country == "USA")
metadata_tree_NLD <- metadata_tree_v0 |> filter(country == "NLD")
chisq.test_CDC <- chisq.test(metadata_tree_CDC$Age_cat, metadata_tree_CDC$Serotype2)
chisq.test_NLD <- chisq.test(metadata_tree_NLD$Age_cat, metadata_tree_NLD$Serotype2)
p_labels <- data.frame(country= c("USA", "NLD"),
pval= c(signif(chisq.test_CDC$p.value , 3), signif(chisq.test_NLD$p.value , 3)),
X2= c(round(chisq.test_CDC$statistic, 1), round(chisq.test_NLD$statistic, 1)))
# Summarise counts and percentages per country x Age_cat x Serotype2
df_pct <- metadata_tree_v0 |>
filter(country != "other") |>
group_by(country, Age_cat, Serotype2) |>
summarise(count = n(), .groups = "drop") |>
group_by(country, Age_cat) |>
mutate(
perc = count / sum(count) * 100,
perc_label = ifelse(perc >= 1, paste0(round(perc), "%"), "")
) |>
ungroup()
# Totals per bar (same as before but from df_pct)
bar_totals <- df_pct |>
group_by(country, Age_cat) |>
summarise(N = sum(count), .groups = "drop")
p_serotype <- df_pct |>
ggplot(aes(x = Age_cat, y = perc, fill = Serotype2)) +
# stacked percentage bars (perc already in data)
geom_col() +
# percentage labels inside segments, only if >= 10%
geom_text(
aes(label = perc_label),
position = position_stack(vjust = 0.5),
color = "white",
size = 5
) +
# total N at top of each bar
geom_text(
data = bar_totals,
aes(x = Age_cat, y = 102, label = paste0("n=", N)),
inherit.aes = FALSE, size=5
) +
facet_grid(. ~ country) +
scale_y_continuous(
name = "Percentage",
limits = c(0, 115),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%")
) +
xlab("Age Category") +
theme_bw() +
scale_fill_manual(name = "Serotype", values = Serotype_colors)+
# add per-country p-values
geom_text(
data = p_labels,
aes(x = 1.3, y = 115, label = paste0("χ²= ", X2)),
inherit.aes = FALSE,
hjust = 0,          # left-justify
size = 4
) +
# add per-country p-values
geom_text(
data = p_labels,
aes(x = 1.25, y = 110, label = paste0("p = ", pval)),
inherit.aes = FALSE,
hjust = 0,          # left-justify
size = 4
) +
# segment above bars connecting them
geom_segment(
aes(x = 1, xend = 2, y = 107, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
# segment above bars connecting them
geom_segment(
aes(x = 1, xend = 1, y = 105, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
# segment above bars connecting them
geom_segment(
aes(x = 2, xend = 2, y = 105, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
ggtitle("Serotype Distribution\nEOD vs LOD/VLOD\n in the USA and Netherlands")+
theme(
plot.title   = element_text(face = "bold", hjust = 0.5, size =15),
axis.title   = element_text(size = 15),   # axis titles
axis.text    = element_text(size = 13),   # axis tick labels
legend.title = element_text(size = 15),   # legend title
legend.text  = element_text(size = 13)    # legend labels
)
