# Prepare data
metadata_CDC <- metadata_tree_v0 |>
filter(label  %in% CDC_accessions)|>
select(label, Age_cat, Serotype2, clonal_complex) |>
rename(Age_cat_7d = Age_cat)|>
mutate(Age_cat_7d= ifelse(Age_cat_7d =="EOD", "Below\nThreshold", "Above\nThreshold"))
phenotypes_EOD_lt14 <- read.table("~/GitHub/GBS-GWAS-CDC-EOD-LOD/1.Bioinformatics/Ouputs/Pyseer Results/CDC/EOD_LOD_Threshold/phenotypes_EOD_lt14.txt", header = T) |>
mutate(binary= ifelse(binary ==0, "Below\nThreshold", "Above\nThreshold")) |>
rename(label  = samples,
Age_cat_14d = binary)
phenotypes_EOD_lt30 <- read.table("~/GitHub/GBS-GWAS-CDC-EOD-LOD/1.Bioinformatics/Ouputs/Pyseer Results/CDC/EOD_LOD_Threshold/phenotypes_EOD_lt30.txt", header = T)|>
mutate(binary= ifelse(binary ==0, "Below\nThreshold", "Above\nThreshold")) |>
rename(label  = samples,
Age_cat_30d = binary)
phenotypes_EOD_lt60 <- read.table("~/GitHub/GBS-GWAS-CDC-EOD-LOD/1.Bioinformatics/Ouputs/Pyseer Results/CDC/EOD_LOD_Threshold/phenotypes_EOD_lt60.txt", header = T)|>
mutate(binary= ifelse(binary ==0, "Below\nThreshold", "Above\nThreshold")) |>
rename(label  = samples,
Age_cat_60d = binary)
metadata_CDC_threshold <- left_join(left_join(left_join(metadata_CDC, phenotypes_EOD_lt14), phenotypes_EOD_lt30), phenotypes_EOD_lt60)
metadata_CDC_threshold_long <-  rbind(metadata_CDC |> rename(Age_cat = Age_cat_7d) |> mutate(threshold= "7 days"),
left_join(metadata_CDC |> select(-Age_cat_7d), phenotypes_EOD_lt14 |> rename(Age_cat = Age_cat_14d)  |> mutate(threshold= "14 days")),
left_join(metadata_CDC |> select(-Age_cat_7d), phenotypes_EOD_lt30 |> rename(Age_cat = Age_cat_30d) |> mutate(threshold= "30 days")),
left_join(metadata_CDC |> select(-Age_cat_7d), phenotypes_EOD_lt60 |> rename(Age_cat = Age_cat_60d) |> mutate(threshold= "60 days")))
# Clonal Complex vs Age Cat in each country
chisq.test_CC_CDC_7d <- chisq.test(metadata_CDC_threshold$Age_cat_7d, metadata_CDC_threshold$clonal_complex)
chisq.test_CC_CDC_14d <- chisq.test(metadata_CDC_threshold$Age_cat_14d, metadata_CDC_threshold$clonal_complex)
chisq.test_CC_CDC_30d <- chisq.test(metadata_CDC_threshold$Age_cat_30d, metadata_CDC_threshold$clonal_complex)
chisq.test_CC_CDC_60d <- chisq.test(metadata_CDC_threshold$Age_cat_60d, metadata_CDC_threshold$clonal_complex)
p_labels_CC_CDC_threshold <- data.frame(threshold= c("7 days", "14 days", "30 days", "60 days"),
pval= c(signif(chisq.test_CC_CDC_7d$p.value , 3), signif(chisq.test_CC_CDC_14d$p.value , 3), signif(chisq.test_CC_CDC_30d$p.value , 3), signif(chisq.test_CC_CDC_60d$p.value , 3)),
X2= c(round(chisq.test_CC_CDC_7d$statistic, 1), round(chisq.test_CC_CDC_14d$statistic, 1), round(chisq.test_CC_CDC_30d$statistic, 1), round(chisq.test_CC_CDC_60d$statistic, 1)))|>
mutate(threshold = factor(threshold, levels=c("7 days", "14 days", "30 days", "60 days")))
# Summarise counts and percentages per country x Age_cat x Serotype2
df_pct_CC_CDC_threshold <- metadata_CDC_threshold_long |>
group_by(threshold, Age_cat, clonal_complex) |>
summarise(count = n(), .groups = "drop") |>
group_by(threshold, Age_cat) |>
mutate(
perc = count / sum(count) * 100,
perc_label = ifelse(perc >= 1, paste0(round(perc), "%"), "")
) |>
ungroup()|>
mutate(threshold = factor(threshold, levels=c("7 days", "14 days", "30 days", "60 days")))
# Totals per bar (same as before but from df_pct)
bar_totals_CC_CDC_threshold <- df_pct_CC_CDC_threshold |>
group_by(threshold, Age_cat) |>
summarise(N = sum(count), .groups = "drop")
p_CC_CDC_threshold <- df_pct_CC_CDC_threshold|>
ggplot(aes(x = Age_cat, y = perc, fill = clonal_complex)) +
# stacked percentage bars (perc already in data)
geom_col() +
# percentage labels inside segments, only if >= 10%
geom_text(
aes(label = perc_label),
position = position_stack(vjust = 0.5),
color = "white",
size = 5
) +
# total N at top of each bar
geom_text(
data = bar_totals_CC_CDC_threshold,
aes(x = Age_cat, y = 102, label = paste0("n=", N)),
inherit.aes = FALSE, size=5
) +
facet_grid(. ~ threshold) +
scale_y_continuous(
name = "Percentage",
limits = c(0, 115),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%")
) +
xlab("Age Category") +
theme_bw() +
scale_fill_manual(name = "Clonal Complex", values = CC_colors)+
# add per-country p-values
geom_text(
data = p_labels_CC_CDC_threshold,
aes(x = 1.3, y = 115, label = paste0("χ²= ", X2)),
inherit.aes = FALSE,
hjust = 0,          # left-justify
size = 4
) +
# add per-country p-values
geom_text(
data = p_labels_CC_CDC_threshold,
aes(x = 1.25, y = 110, label = paste0("p = ", pval)),
inherit.aes = FALSE,
hjust = 0,          # left-justify
size = 4
) +
# segment above bars connecting them
geom_segment(
aes(x = 1, xend = 2, y = 107, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
# segment above bars connecting them
geom_segment(
aes(x = 1, xend = 1, y = 105, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
# segment above bars connecting them
geom_segment(
aes(x = 2, xend = 2, y = 105, yend = 107),
inherit.aes = FALSE,
linewidth = 0.7
)+
ggtitle("Clonal Complex Distribution across Age of Onset Binarization Thresholds")+
theme(
plot.title   = element_text(face = "bold", hjust = 0.5, size =15),
axis.title   = element_text(size = 15),   # axis titles
axis.text    = element_text(size = 13),   # axis tick labels
legend.title = element_text(size = 15),   # legend title
legend.text  = element_text(size = 13)    # legend labels
)
