## prepare data
PanGWAS_Roary_Clarc_Shared_df <- left_join(PanGWAS_Roary |>
filter(variant %in% PanGWAS_Roary_Clarc$variant)|>
select(variant, filter.pvalue, lrt.pvalue)|>
rename("Roary_Clarc_lrt.pvalue"="lrt.pvalue")|>
rename("Roary_Clarc_filter.pvalue"="filter.pvalue"),
PanGWAS_Roary_Clarc |>
select(variant, filter.pvalue, lrt.pvalue)|>
rename("Roary_lrt.pvalue"="lrt.pvalue")|>
rename("Roary_filter.pvalue"="filter.pvalue"))
## Plot
# nrow(PanGWAS_Roary_Clarc_Shared_df)
# Unadjusted
cor_test_Roary_Clarc_Unadjusted <- cor.test(PanGWAS_Roary_Clarc_Shared_df$Roary_filter.pvalue,
PanGWAS_Roary_Clarc_Shared_df$Roary_Clarc_filter.pvalue,
method = "pearson")
cor_coef_Roary_Clarc_Unadjusted <- cor_test_Roary_Clarc_Unadjusted$estimate
p_value_Roary_Clarc_Unadjusted <- cor_test_Roary_Clarc_Unadjusted$p.value
PanGWAS_Roary_Clarc_Shared_df|>
ggplot()+
geom_point(aes(x=Roary_filter.pvalue, y= Roary_Clarc_filter.pvalue))+
geom_abline(intercept = 0, slope = 1, color = "blue", linetype = "dashed", size = 1)+
theme_classic()+
xlab("Roary Unadjusted p-value")+
ylab("Roary + CLARC Unadjusted p-value")+
annotate( "text",
x = 0.9, y = 1, # Adjust position as needed
label = paste0("r = ", round(cor_coef_Roary_Clarc_Unadjusted, 2),
"\nP = ", format.pval(p_value_Roary_Clarc_Unadjusted, digits = 2)),
color = "red",
size = 5)+
ggtitle("Unadjusted p-value of Genes overlapping between Roary and Roary + CLARC") +
geom_hline(yintercept = 0.05/nrow(PanGWAS_Roary), color = "red", linetype = "dashed", size = 1)+
geom_hline(yintercept= 0.05/nrow(PanGWAS_Roary_Clarc), color = "red", linetype = "dashed", size = 1)
# Adjusted
cor_test_Roary_Clarc_Adjusted <- cor.test(PanGWAS_Roary_Clarc_Shared_df$Roary_lrt.pvalue,
PanGWAS_Roary_Clarc_Shared_df$Roary_Clarc_lrt.pvalue,
method = "pearson")
cor_coef_Roary_Clarc_Adjusted <- cor_test_Roary_Clarc_Adjusted$estimate
p_value_Roary_Clarc_Adjusted <- cor_test_Roary_Clarc_Adjusted$p.value
