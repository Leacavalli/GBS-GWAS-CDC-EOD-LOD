# Compare shared
PanGWAS_Panaroo |>
filter(variant %in% PanGWAS_Roary$variant)
# Clean environment
rm( list = ls() )
# load necessary libraries
library(tidyverse)
library(ggplot2)
# load data
## Panaroo
PanGWAS_Panaroo <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Preliminary Analysis/Lea Figures/Data/15.Pyseer/15.1.Main_analysis/PanGWAS_Panaroo_RAxML.txt")
## Roary
PanGWAS_Roary <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Preliminary Analysis/Lea Figures/Data/15.Pyseer/15.3.Subanalysis_2/PanGWAS_Roary_RAxML.txt")
## Panaroo + Clarc
PanGWAS_Panaroo_Clarc <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Preliminary Analysis/Lea Figures/Data/15.Pyseer/15.3.Subanalysis_2/PanGWAS_Panaroo_CLARC_RAxML.txt")
## Roary + Clarc
PanGWAS_Roary_Clarc <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Preliminary Analysis/Lea Figures/Data/15.Pyseer/15.3.Subanalysis_2/PanGWAS_Roary_CLARC_RAxML.txt")
# Add significance column, with bonferonni correction for multiple testing
PanGWAS_Panaroo <- PanGWAS_Panaroo |>
mutate(significance = ifelse(lrt.pvalue < 0.05/nrow(PanGWAS_Panaroo), "significant", "not significant"))|>
mutate(PanGWAS_Roary = factor(significance, levels= c("significant", "not significant")))
PanGWAS_Roary <- PanGWAS_Roary  |>
mutate(significance = ifelse(lrt.pvalue < 0.05/nrow(PanGWAS_Roary), "significant", "not significant"))|>
mutate(significance = factor(significance, levels= c("significant", "not significant")))
PanGWAS_Panaroo_Clarc <- PanGWAS_Panaroo_Clarc |>
mutate(significance = ifelse(lrt.pvalue < 0.05/nrow(PanGWAS_Panaroo_Clarc), "significant", "not significant"))|>
mutate(significance = factor(significance, levels= c("significant", "not significant")))
PanGWAS_Roary_Clarc <- PanGWAS_Roary_Clarc |>
mutate(significance = ifelse(lrt.pvalue < 0.05/nrow(PanGWAS_Roary_Clarc), "significant", "not significant"))|>
mutate(significance = factor(significance, levels= c("significant", "not significant")))
# Number of COGs for each method
nrow(PanGWAS_Panaroo)
nrow(PanGWAS_Roary)
nrow(PanGWAS_Panaroo_Clarc)
nrow(PanGWAS_Roary_Clarc)
# OVERLAPS
## COG overlap in Panaroo and Roary
length(which(PanGWAS_Panaroo$variant %in% PanGWAS_Roary$variant))
## COG overlap in Panaroo and Panaroo + Clarc
length(which(PanGWAS_Panaroo$variant %in% PanGWAS_Panaroo_Clarc$variant))
## COG overlap in Roary and Roary + Clarc
length(which(PanGWAS_Roary$variant %in% PanGWAS_Roary_Clarc$variant))
## COGs found across all
shared_all <- names(which(table(c(PanGWAS_Panaroo$variant, PanGWAS_Roary$variant, PanGWAS_Panaroo_Clarc$variant, PanGWAS_Roary_Clarc$variant))== 4))
length(shared_all)
# Compare shared
PanGWAS_Panaroo |>
filter(variant %in% PanGWAS_Roary$variant)
