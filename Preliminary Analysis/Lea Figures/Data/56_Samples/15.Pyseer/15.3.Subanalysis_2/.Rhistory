library(ggplot2)
library(reshape2)
# Heatmap
# Generate sample data (10x10 matrix with random values)
set.seed(123)
data_matrix <- matrix(rnorm(100), nrow = 10)
# Convert the matrix to a data frame and melt into long format
data_long <- melt(data_matrix)
# Create the heatmap
ggplot(data_long, aes(Var1, Var2, fill = value)) +
geom_tile() +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0) +
labs(x = "Column", y = "Row", fill = "Value") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
ggtitle("Heatmap Example")
data_long
# Create the heatmap
ggplot(aes(variant, Pop_structure, fill = lrt.pvalue)) +
geom_tile() +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0.5) +
labs(x = "Column", y = "Row", fill = "Value") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
ggtitle("Heatmap Example")
rbind(SNPGWAS_RAxML |> select(variant, lrt.pvalue)|>  mutate(Pop_structure= "RAxML"),
SNPGWAS_Mash |> select(variant, lrt.pvalue)|>  mutate(Pop_structure= "Mash")) |>
